{
  "name": "DriftwoodIsles",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "ReleaseVersion": { "$className": "StringValue", "$properties": { "Value": "0.1.0-alpha.3" } }
    },
    "ServerScriptService": { "Server": { "$path": "src/server" } },
    "StarterPlayer": {
      "StarterPlayerScripts": { "Client": { "$path": "src/client" } },
      "$properties": { "CharacterWalkSpeed": 18, "CameraMaxZoomDistance": 85, "CameraMinZoomDistance": 8 }
    },
    "Workspace": { "$properties": { "Gravity": 196.2, "FallenPartsDestroyHeight": -100 } },
    "SoundService": { "$properties": { "RespectFilteringEnabled": true } }
  }
}
